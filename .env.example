# Copy to .env and fill in. Never commit .env.

# edit = local authoring (default)
# viewer = local read-only preview
# production = Render: / view + /admin edit
POP_MODE=edit

# Admin password (required on Render when POP_MODE=production)
ADMIN_PASSWORD=replace-with-strong-admin-password

# Optional view password for public / portal (VIEW_PASSWORD preferred; SITE_PASSWORD is an alias)
# Can also be set/cleared at runtime from /admin → Site access
VIEW_PASSWORD=
# SITE_PASSWORD=

SECRET_KEY=replace-with-long-random-string

# Local port (Render sets PORT automatically)
PORT=8765

# Persistent disk root on Render. When set, content lives under:
#   $PUBLISH_DATA_ROOT/workspace
#   $PUBLISH_DATA_ROOT/_pdf_review
#   $PUBLISH_DATA_ROOT/_official
#   $PUBLISH_DATA_ROOT/site_auth.json
# PUBLISH_DATA_ROOT=/data

# Shared secret for ./scripts/push_publish_to_render.sh → POST /api/admin/sync
ADMIN_SYNC_TOKEN=replace-with-long-random-token

# Target URL for push script (no trailing slash)
# RENDER_SYNC_URL=https://your-service.onrender.com

# Optional: use frozen publish/inventory.json in viewer (usually leave unset)
# POP_FROZEN_PUBLISH=1

# Render Postgres (optional catalog; leave unset for file-based viewer)
# DATABASE_URL=postgres://...
